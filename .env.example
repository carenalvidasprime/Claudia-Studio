# Copia este archivo a `.env` para desarrollo local.
# En Cloudflare Pages estas mismas variables se definen en
# Settings → Environment variables (build & preview).
#
# Ninguna de estas es una clave secreta: la `anon key` de Supabase es publicable
# por diseño y lo que protege los datos son las políticas RLS. Las credenciales
# reales (service_role, clave del modelo de imagen) viven solo dentro de n8n.

VITE_SUPABASE_URL=https://gegcgyznynrpmxqtjmrv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Webhook que genera la imagen, la sube al bucket y crea la fila en `piezas`.
VITE_N8N_GENERAR_URL=https://carlosarenal.app.n8n.cloud/webhook/claudia-generar

# Webhook del copiloto conversacional. Contrato en n8n/claudia-chat.md.
# Si se deja vacío, el chat avisa de que no está disponible en lugar de fallar.
VITE_N8N_CHAT_URL=
